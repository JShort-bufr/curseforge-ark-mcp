# Copy to .env and fill in. .env is gitignored; NEVER commit a real key.
#
# Precedence: process.env (your MCP client's env block) wins over this file.
# This file is found relative to the server's own code, not your shell's cwd.

# ---------------------------------------------------------------------------
# CURSEFORGE_API_KEY — required. The server REFUSES TO START without it.
# ---------------------------------------------------------------------------
# Sent as the `x-api-key` request header (ADR-002 §2). NOT an
# `Authorization: Bearer` token — that is the sibling Nitrado server's scheme
# and this repo deliberately does not support it.
#
# The key is NOT self-service. It is granted by application to Overwolf, and it
# is non-transferable under their terms. A leak means revoke and REAPPLY, and
# reapplication is a queue rather than a reset. See the README.
CURSEFORGE_API_KEY=

# --- Everything below is optional ---

# The slug GET /v1/games is matched against to discover the ARK: Survival
# Ascended gameId at runtime (ADR-002 §5). The gameId is NEVER hardcoded: a
# wrong one returns a clean, empty, entirely wrong search result set.
#
# UNVERIFIED (§14.3 U1/U2): no key exists yet, and GET /v1/games returns only
# the games available to the calling key, so neither the slug nor whether ASA is
# visible to the key at all could be checked. Set this if the built-in candidate
# list does not match once the key arrives.
CURSEFORGE_GAME_SLUG=

# Self-imposed pacing. CurseForge publishes NO rate limit (§14.3 U11), so this
# number is ours and not their contract. get_api_diagnostics reports whatever
# rate-limit headers a real response actually carried, or null — never a guess.
CURSEFORGE_MAX_RPS=2

CURSEFORGE_TIMEOUT_MS=20000

# NOTE, and it is a control rather than an omission (ADR-002 §9): there is no
# NITRADO_* variable in this file and there must never be one. This server makes
# no Nitrado call, holds no Nitrado token, and reads no Nitrado config. A
# credential that is not read cannot be leaked, logged, or blast-radiused. The
# host pin in src/allowlist.ts enforces the "no Nitrado call" half mechanically.
