# Credentials. Never commit. See ADR-002 §2.
.env
.env.*
!.env.example
*.token
*.key

# Claude Code local overrides (an MCP server env block can carry the API key)
.claude/settings.local.json

# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Build provenance, regenerated by scripts/generate-buildinfo.mjs before every
# tsc run (ADR-002 §13.3). Generated rather than committed so it can never
# disagree with the commit it names, and so it does not turn every build into a
# spurious diff.
src/buildinfo.ts

# OS / editor
.DS_Store
Thumbs.db
*.swp
